# Firebase Configuration
# Copia este archivo como .env y reemplaza los valores con tus credenciales reales de Firebase

REACT_APP_FIREBASE_API_KEY=tu_api_key_aqui
REACT_APP_FIREBASE_AUTH_DOMAIN=tu_proyecto.firebaseapp.com
REACT_APP_FIREBASE_PROJECT_ID=tu_project_id
REACT_APP_FIREBASE_STORAGE_BUCKET=tu_proyecto.appspot.com
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=tu_sender_id
REACT_APP_FIREBASE_APP_ID=tu_app_id

# Instrucciones:
# 1. Copia este archivo como .env: cp .env.example .env
# 2. Ve a Firebase Console: https://console.firebase.google.com/
# 3. Selecciona tu proyecto > Project Settings > General
# 4. Copia las credenciales de tu app web
# 5. Reemplaza los valores en .env con tus credenciales reales
# 6. NUNCA subas el archivo .env a Git (ya está en .gitignore)

